---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChannelData from '../components/ChannelData.astro';
import { getChannels } from '../lib/data';
import { DEFAULT_PROFILE, evaluateChannel, rankVerdicts } from '../lib/eligibility';
import { renderResults } from '../lib/render';
import { INVESTOR_LABEL, FUND_SOURCE_LABEL } from '../lib/labels';
import { INVESTOR_TYPES } from '../lib/schema';

const channels = getChannels();

// Rendered at build time for the default profile so the page has real content in its HTML:
// the results are the point of the page, and they used to exist only after the script ran.
const initialResults = renderResults(
  rankVerdicts(channels.map((channel) => evaluateChannel(channel, DEFAULT_PROFILE))),
  DEFAULT_PROFILE,
);
---

<BaseLayout
  title="Check your case"
  description="Tell us where you live, where the money sits and what you can do in Chinese, and see which onshore investment channels in China are actually open to you."
>
  <section class="section">
    <div class="wrap">
      <p class="hero__eyebrow">Eligibility check</p>
      <h1 style="margin-top:.6rem">What can you actually open?</h1>
      <p class="lede">
        Ten questions. Everything runs in your browser — no account, no email, nothing stored.
        The link at the end carries your answers, so you can send it to a friend or a banker.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="grid" style="grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:2rem;align-items:start">
        <div>
          <form class="card" id="check-form" style="padding:1.4rem">
            <div class="form-grid">
              <div class="field">
                <label for="investor">Who are you</label>
                <select id="investor" name="investor">
                  {INVESTOR_TYPES.map((t) => (
                    <option value={t} selected={t === DEFAULT_PROFILE.investor}>
                      {INVESTOR_LABEL[t]}
                    </option>
                  ))}
                </select>
              </div>

              <div class="field">
                <label for="source">Where is the money</label>
                <select id="source" name="source">
                  {(['onshore-rmb-income', 'onshore-rmb-asset-sale', 'offshore-fx', 'offshore-cnh'] as const).map((s) => (
                    <option value={s} selected={s === DEFAULT_PROFILE.source}>{FUND_SOURCE_LABEL[s]}</option>
                  ))}
                </select>
                <p class="tiny muted" style="margin-top:.3rem">
                  This is the question that changes everything. Offshore money usually has to come in
                  through an inbound route first.
                </p>
              </div>

              <div class="field">
                <label for="months">Time in China</label>
                <select id="months" name="months">
                  {([['none', 'Not in China'], ['lt6', 'Less than 6 months'], ['6to12', '6–12 months'], ['1to3', '1–3 years'], ['3plus', 'More than 3 years']] as const).map(([v, label]) => (
                    <option value={v} selected={v === DEFAULT_PROFILE.months}>{label}</option>
                  ))}
                </select>
              </div>

              <div class="field">
                <label for="visa">Visa / status</label>
                <select id="visa" name="visa">
                  {([['work', 'Work permit'], ['student', 'Student'], ['family', 'Family / dependent'], ['permanent', 'Permanent residence'], ['visitor', 'Visitor / no residence permit']] as const).map(([v, label]) => (
                    <option value={v} selected={v === DEFAULT_PROFILE.visa}>{label}</option>
                  ))}
                </select>
              </div>

              <div class="field">
                <label for="amount">Amount you could invest</label>
                <select id="amount" name="amount">
                  {(['30000', '300000', '1500000', '5000000'] as const).map((v, i) => (
                    <option value={v} selected={Number(v) === DEFAULT_PROFILE.amount}>
                      {['Under CNY 50,000', 'CNY 50,000 – 500,000', 'CNY 500,000 – 3 million', 'Above CNY 3 million'][i]}
                    </option>
                  ))}
                </select>
              </div>

              <div class="field">
                <label for="visit">Branch visits</label>
                <select id="visit" name="visit">
                  <option value="yes" selected={DEFAULT_PROFILE.canVisit}>I can go in person</option>
                  <option value="no" selected={!DEFAULT_PROFILE.canVisit}>Online only</option>
                </select>
              </div>

              <div class="field">
                <label for="chinese">Chinese</label>
                <select id="chinese" name="chinese">
                  {([['none', 'None'], ['basic', 'Basic'], ['fluent', 'Fluent']] as const).map(([v, label]) => (
                    <option value={v} selected={v === DEFAULT_PROFILE.chinese}>{label}</option>
                  ))}
                </select>
              </div>

              <div class="field">
                <label for="bank">Local bank account</label>
                <select id="bank" name="bank">
                  <option value="yes" selected={DEFAULT_PROFILE.hasBank}>Yes, I have one</option>
                  <option value="no" selected={!DEFAULT_PROFILE.hasBank}>Not yet</option>
                </select>
              </div>

              <div class="field">
                <label for="phone">Chinese mobile number</label>
                <select id="phone" name="phone">
                  <option value="yes" selected={DEFAULT_PROFILE.hasPhone}>Yes, in my name</option>
                  <option value="no" selected={!DEFAULT_PROFILE.hasPhone}>No</option>
                </select>
              </div>

              <div class="field">
                <label for="brokerage">Securities account</label>
                <select id="brokerage" name="brokerage">
                  <option value="no" selected={!DEFAULT_PROFILE.hasBrokerage}>No</option>
                  <option value="yes" selected={DEFAULT_PROFILE.hasBrokerage}>Yes, I have one</option>
                </select>
                <p class="tiny muted" style="margin-top:.3rem">
                  Brokers open these in person. Anything traded on an exchange needs one first.
                </p>
              </div>
            </div>

            <div class="row" style="margin-top:1.2rem">
              <button class="btn" type="submit">Show my options</button>
              <button class="btn btn--ghost btn--sm" type="button" id="copy-link" hidden>Copy shareable link</button>
            </div>
            <p class="tiny muted" style="margin-top:.9rem">
              This is a filter, not an assessment. It tells you which combinations to check, not
              whether a product suits you.
            </p>
          </form>

          <noscript>
            <div class="callout callout--info" style="margin-top:1rem">
              <p class="callout__title">JavaScript is off</p>
              <p class="small">
                The filter runs in your browser, so it needs JavaScript. You can still read the
                <a href="/matrix">full matrix</a>.
              </p>
            </div>
          </noscript>

          <div id="results" aria-live="polite" style="margin-top:2rem" set:html={initialResults}></div>
        </div>

        <aside class="stack">
          <div class="card card--flat">
            <span class="card__kicker">Why this exists</span>
            <p class="small" style="margin-top:.5rem">
              Most English guides answer “what should I buy”. Almost nobody answers “can I even open
              this”. This page answers the second question.
            </p>
          </div>
          <div class="card card--flat">
            <span class="card__kicker">Four states, honestly</span>
            <ul class="dotlist" style="margin-top:.6rem">
              <li><strong>Open</strong> — a published route exists.</li>
              <li><strong>Conditional</strong> — possible if you satisfy something.</li>
              <li><strong>Not verified</strong> — we have not checked. Not a no.</li>
              <li><strong>Not available</strong> — blocked, with the reason.</li>
            </ul>
          </div>
          <div class="card card--flat">
            <span class="card__kicker">Money from abroad?</span>
            <p class="small" style="margin-top:.5rem">
              Individuals have almost no legal route to invest offshore money onshore. Read
              <a href="/playbooks/inbound-funding">how money gets in</a> before assuming a transfer will work.
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <ChannelData channels={channels} />

  <script>
    import {
      evaluateChannel,
      profileFromParams,
      profileToParams,
      rankVerdicts,
      type Profile,
    } from '../lib/eligibility';
    import { renderResults } from '../lib/render';

    const raw = document.getElementById('channel-data')?.textContent ?? '[]';
    const channels = JSON.parse(raw);

    const form = document.getElementById('check-form') as HTMLFormElement;
    const results = document.getElementById('results') as HTMLElement;
    const copyBtn = document.getElementById('copy-link') as HTMLButtonElement;

    function readProfile(): Profile {
      const fd = new FormData(form);
      return {
        investor: String(fd.get('investor')) as Profile['investor'],
        source: String(fd.get('source')) as Profile['source'],
        months: String(fd.get('months')) as Profile['months'],
        visa: String(fd.get('visa')) as Profile['visa'],
        amount: Number(fd.get('amount')) || 0,
        canVisit: String(fd.get('visit')) === 'yes',
        chinese: String(fd.get('chinese')) as Profile['chinese'],
        hasBank: String(fd.get('bank')) === 'yes',
        hasPhone: String(fd.get('phone')) === 'yes',
        hasBrokerage: String(fd.get('brokerage')) === 'yes',
      };
    }

    function render(profile: Profile) {
      const verdicts = rankVerdicts(channels.map((c: any) => evaluateChannel(c, profile)));
      results.innerHTML = renderResults(verdicts, profile);
      copyBtn.hidden = false;
    }

    function syncUrl() {
      const params = profileToParams(readProfile());
      history.replaceState(null, '', `${location.pathname}?${params.toString()}`);
    }

    function writeProfile(profile: Profile) {
      const setValue = (name: string, value: string) => {
        const el = form.elements.namedItem(name) as HTMLSelectElement | null;
        if (el) el.value = value;
      };
      setValue('investor', profile.investor);
      setValue('source', profile.source);
      setValue('months', profile.months);
      setValue('visa', profile.visa);
      setValue('amount', String(profile.amount));
      setValue('visit', profile.canVisit ? 'yes' : 'no');
      setValue('chinese', profile.chinese);
      setValue('bank', profile.hasBank ? 'yes' : 'no');
      setValue('phone', profile.hasPhone ? 'yes' : 'no');
      setValue('brokerage', profile.hasBrokerage ? 'yes' : 'no');
    }

    function applyParams() {
      const params = new URLSearchParams(location.search);
      if ([...params.keys()].length === 0) return false;
      writeProfile(profileFromParams(params));
      return true;
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const profile = readProfile();
      render(profile);
      syncUrl();
    });

    form.addEventListener('change', () => {
      if (results.childElementCount === 0) return;
      const profile = readProfile();
      render(profile);
      syncUrl();
    });

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        copyBtn.textContent = 'Link copied';
        setTimeout(() => (copyBtn.textContent = 'Copy shareable link'), 2000);
      } catch {
        copyBtn.textContent = 'Copy failed — select the URL bar';
      }
    });

    const hadParams = applyParams();
    render(readProfile());
    if (!hadParams) {
      const hint = document.createElement('p');
      hint.className = 'tiny muted';
      hint.style.marginTop = '.6rem';
      hint.textContent =
        'Showing a default profile: a foreign work-permit holder with RMB earned in China. Change the answers above to see yours.';
      results.appendChild(hint);
    }
  </script>
</BaseLayout>
