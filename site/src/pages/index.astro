---
import BaseLayout from '../layouts/BaseLayout.astro';
import MatrixTable from '../components/MatrixTable.astro';
import FrictionBar from '../components/FrictionBar.astro';
import FreshnessBadge from '../components/FreshnessBadge.astro';
import { getChannels } from '../lib/data';
import { TYPE_LABEL } from '../lib/labels';

const all = getChannels();
const previewIds = ['bank-account', 'public-fund', 'a-share', 'northbound', 'personal-inbound'];
const preview = all.filter((c) => previewIds.includes(c.id));

const scenarios = [
  {
    title: 'I live and earn here',
    body: 'You hold a residence permit and your money is RMB in a local bank. This is where the access is widest — and where the paperwork gets in the way.',
    href: '/check?investor=resident-foreign-individual',
    tag: 'Widest access',
  },
  {
    title: 'I am outside China',
    body: 'Your money sits offshore. Individuals have very few legal routes in; institutions have several. Start by understanding which one you are.',
    href: '/check?investor=non-resident-individual',
    tag: 'Narrowest access',
  },
  {
    title: 'I run a company here',
    body: 'A foreign-invested enterprise with RMB on the books. Treasury products, deposits and bond access look different for a legal entity.',
    href: '/check?investor=onshore-fie',
    tag: 'Entity rules',
  },
  {
    title: 'I am an institution',
    body: 'A fund, family office or company allocating into China. QFII, Northbound and the interbank bond market are the real doors.',
    href: '/check?investor=offshore-institution',
    tag: 'Institutional routes',
  },
];

const reads = [
  {
    title: 'How money actually gets in',
    body: 'Current account versus capital account, and why an individual cannot simply wire money in to buy shares.',
    href: '/playbooks/inbound-funding',
    kicker: 'Playbook',
  },
  {
    title: 'What the USD 50,000 quota is — and is not',
    body: 'The most misunderstood number in Chinese personal finance. It is a conversion quota, not an investment allowance.',
    href: '/explainers/usd-50k-quota',
    kicker: 'Explainer',
  },
  {
    title: 'How this site is checked',
    body: 'Every status, date and caveat has a method behind it. Read this before you trust anything here.',
    href: '/methodology',
    kicker: 'Method',
  },
];

const quick = all.slice(0, 5);
---

<BaseLayout
  title="Onshore"
  description="Which onshore investment channels a foreigner can actually use in China — eligibility, documents, friction. Money in, and RMB earned here."
>
  <section class="hero">
    <div class="wrap">
      <p class="hero__eyebrow">Onshore · China</p>
      <h1>Investing in China,<br />if you're not Chinese.</h1>
      <p class="lede">
        A map of what a foreigner — or a foreign institution — can actually open in mainland China:
        bank accounts, funds, A-shares, bonds and the routes money takes to get here.
        Built from rules and documents, with the date we checked them.
      </p>

      <div class="scope">
        <span class="scope__pill">Money entering China</span>
        <span class="scope__pill">RMB earned here, invested here</span>
        <span class="scope__pill scope__pill--no">Not covered: offshore accounts, QDII, moving money out</span>
      </div>

      <div class="row" style="margin-top:1.6rem">
        <a class="btn" href="/check">Check what you can open</a>
        <a class="btn btn--ghost" href="/matrix">See the full matrix</a>
      </div>

      <p class="tiny muted" style="margin-top:1rem">
        No account. No email. Nothing leaves your browser.
      </p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="steps">
        <div class="step">
          <h3>Tell us who you are</h3>
          <p>Where you live, where the money sits, and how much of the process you can do in Chinese.</p>
        </div>
        <div class="step">
          <h3>See what is open</h3>
          <p>Four states: open, conditional, not available — and “not verified”, which is not a no.</p>
        </div>
        <div class="step">
          <h3>Compare the friction</h3>
          <p>Documents, branch visits, language, minimums and exit. Never expected returns.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="spread">
        <div>
          <p class="hero__eyebrow">The matrix</p>
          <h2 style="margin-top:.5rem">Who can use what</h2>
        </div>
        <a class="btn btn--ghost btn--sm" href="/matrix">Full matrix →</a>
      </div>
      <p class="muted" style="max-width:60ch;margin:1rem 0 1.4rem">
        Five of the {all.length} channels. A dash means we have not verified that combination yet —
        rarely that it is impossible.
      </p>

      <MatrixTable channels={preview} />

      <div class="legend" style="margin-top:1rem">
        <span><span class="badge badge--open badge--sm">Open</span> published route</span>
        <span><span class="badge badge--conditional badge--sm">Conditional</span> possible with conditions</span>
        <span><span class="badge badge--closed badge--sm">Not available</span> no general route</span>
        <span><span class="badge badge--unknown badge--sm">Not verified</span> we have not checked</span>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="hero__eyebrow">Start where you are</p>
      <h2 style="margin-top:.5rem">Four situations, four different answers</h2>

      <div class="grid grid--2" style="margin-top:1.6rem">
        {scenarios.map((s) => (
          <a class="card card--link" href={s.href}>
            <span class="card__kicker">{s.tag}</span>
            <h3 class="card__title">{s.title}</h3>
            <p class="card__body">{s.body}</p>
            <span class="tiny" style="display:inline-block;margin-top:.8rem">Open the check →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="spread">
        <h2>Read before you plan</h2>
        <a class="btn btn--ghost btn--sm" href="/playbooks">All playbooks →</a>
      </div>
      <div class="grid grid--3" style="margin-top:1.4rem">
        {reads.map((r) => (
          <a class="card card--link" href={r.href}>
            <span class="card__kicker">{r.kicker}</span>
            <h3 class="card__title">{r.title}</h3>
            <p class="card__body">{r.body}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <h2 style="font-size:1.2rem">Recently added channels</h2>
      <ul class="list-plain" style="margin-top:1rem">
        {quick.map((c) => (
          <li class="spread" style="border-bottom:1px solid var(--line);padding-bottom:.6rem">
            <span>
              <a href={`/channels/${c.id}`}><strong>{c.name}</strong></a>
              <span class="muted small"> · {TYPE_LABEL[c.type]}</span>
            </span>
            <span class="row">
              <FrictionBar friction={c.friction} showLabel={false} />
              <FreshnessBadge date={c.lastVerified} verifiedBy={c.verifiedBy} short />
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section--tight">
    <div class="wrap">
      <div class="callout callout--info">
        <p class="callout__title">What this site is not</p>
        <p class="small">
          Not a broker, not an adviser, not a fund supermarket. We do not sell products, take
          commissions, or recommend what to buy. We document what exists, what it takes to open,
          and how hard it is to get out — then let you decide.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
