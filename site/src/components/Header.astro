---
const path = Astro.url.pathname;
const links = [
  { href: '/matrix', label: 'Matrix' },
  { href: '/channels', label: 'Channels' },
  { href: '/playbooks', label: 'Playbooks' },
  { href: '/explainers', label: 'Explainers' },
  { href: '/methodology', label: 'Method' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/" aria-label="Onshore — home">
      <svg class="brand__mark" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <rect x="1.25" y="1.25" width="25.5" height="25.5" rx="6" stroke="currentColor" stroke-width="1.5"></rect>
        <path d="M10 21V11.5a4 4 0 0 1 8 0V21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        <circle cx="14" cy="16" r="1.6" fill="currentColor"></circle>
      </svg>
      <span>Onshore</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <details class="nav__menu">
      <summary aria-label="Open menu">Menu</summary>
      <nav aria-label="Primary mobile">
        {links.map((l) => (
          <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
    </details>
  </div>
</header>
