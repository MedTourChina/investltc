            <path d="M10 21V11.5a4 4 0 0 1 8 0V21" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
            <circle cx="14" cy="16" r="1.6" fill="currentColor"></circle>
          </svg>
          <span>Lifetourchina Invest</span>
        </a>
        <p class="small muted" style="margin-top:.7rem;max-width:34ch">
          A map of onshore investment channels in China for people who are not Chinese.
          Money in, and RMB earned here.
        </p>
      </div>

      <div>
        <h2>Explore</h2>
        <ul>
          <li><a href="/matrix">Access matrix</a></li>
          <li><a href="/check">Check your case</a></li>
